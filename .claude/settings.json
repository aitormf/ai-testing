{
  "enabledPlugins": {
    "harness@aitormf": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(./scripts/check.sh)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Bash(pip install *)",
      "Bash(uv pip install *)",
      "Bash(git commit --no-verify *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(./.github/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_new_package.py"
          },
          {
            "type": "command",
            "command": "uv run python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask_on_force_push.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep '\\.py$' | xargs -r uv run ruff format --quiet"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh"
          }
        ]
      }
    ]
  }
}
